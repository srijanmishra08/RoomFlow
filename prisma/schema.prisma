generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js Models ───────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain Models ────────────────────────────────────────────

enum Role {
  ADMIN
  DESIGNER
  CLIENT
}

enum Plan {
  FREE
  PRO
  STUDIO
}

enum ObjectStatus {
  PLANNED
  IN_PROGRESS
  FINALIZED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(DESIGNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions       Session[]

  designer       Designer?
  client         Client?
  comments       Comment[]
  activities     Activity[]
  approvals      Approval[]
  notifications  Notification[]
  assignedTasks  ProjectTask[]
  driveItems     DriveItem[]
  savedViews     SavedView[]
  teamMemberships TeamMember[]
}

model Designer {
  id         String  @id @default(cuid())
  userId     String  @unique
  studioName String?
  phone      String?
  bio        String? @db.Text
  // SaaS subscription
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  planRenewsAt         DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients  Client[]
  projects Project[]
  assets   Asset[]
  invoices Invoice[]
  teamMembers TeamMember[]
}

// A user granted access to a designer's studio. ASSISTANT can edit
// projects/rooms/objects; VIEWER is read-only. The Designer row itself is
// the implicit OWNER.
enum TeamRole {
  ASSISTANT
  VIEWER
}

model TeamMember {
  id         String   @id @default(cuid())
  designerId String
  userId     String
  role       TeamRole @default(VIEWER)
  createdAt  DateTime @default(now())

  designer Designer @relation(fields: [designerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([designerId, userId])
  @@index([userId])
}

model Client {
  id         String  @id @default(cuid())
  userId     String  @unique
  designerId String
  phone      String?
  address    String? @db.Text

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  designer Designer  @relation(fields: [designerId], references: [id], onDelete: Cascade)
  projects Project[]
  invoices Invoice[]
}

model Project {
  id         String        @id @default(cuid())
  designerId String
  clientId   String?
  title      String
  description String?      @db.Text
  status     ProjectStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  designer   Designer   @relation(fields: [designerId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  rooms      Room[]
  activities Activity[]
  invoices   Invoice[]
  driveItems DriveItem[]
  tasks      ProjectTask[]
  quotations Quotation[]
}

model Room {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  width           Float    @default(5)
  height          Float    @default(3)
  depth           Float    @default(5)
  level           Int      @default(0)  // floor number for multi-floor projects (0 = ground)
  // Polygon floor plan: array of {x,z} points. If set, replaces cuboid shape.
  floorPoints     Json?    // [{x: number, z: number}, ...]
  // Wall openings (doors/windows): [{wall: edgeIndex, offset: 0..1, width, height, sill, type: "door"|"window"}, ...]
  openings        Json?
  // Direct 3D file for the entire room (uploaded .glb/.gltf from Blender/AutoCAD)
  modelUrl        String?
  // Surface materials
  floorMaterial   Json?    // {type: "color"|"texture", value: string, repeat?: number}
  wallMaterial    Json?    // {type: "color"|"texture", value: string, repeat?: number}
  ceilingMaterial Json?    // {type: "color"|"texture", value: string, repeat?: number}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objects   RoomObject[]
  revisions Revision[]
  tasks     ProjectTask[]
  views     SavedView[]
  driveItems DriveItem[]
}

model RoomObject {
  id        String       @id @default(cuid())
  roomId    String
  name      String
  modelUrl  String?
  positionX Float        @default(0)
  positionY Float        @default(0)
  positionZ Float        @default(0)
  rotationX Float        @default(0)
  rotationY Float        @default(0)
  rotationZ Float        @default(0)
  scaleX    Float        @default(1)
  scaleY    Float        @default(1)
  scaleZ    Float        @default(1)
  status    ObjectStatus @default(PLANNED)
  material  String?
  brand     String?
  supplier  String?
  cost      Float?
  currency  String       @default("INR")
  deliveryDate DateTime?
  color     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  comments  Comment[]
  approvals Approval[]
}

model Comment {
  id        String   @id @default(cuid())
  objectId  String
  userId    String
  content   String   @db.Text
  language  String?
  audioUrl  String?
  transcript String? @db.Text
  createdAt DateTime @default(now())

  object RoomObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id         String   @id @default(cuid())
  designerId String
  name       String
  fileUrl    String
  fileType   String   @default("glb")
  thumbnail  String?
  category   String?
  tags       String[]
  createdAt  DateTime @default(now())

  designer Designer @relation(fields: [designerId], references: [id], onDelete: Cascade)
}

// ─── Revisions ────────────────────────────────────────────────

enum RevisionType {
  MODEL_3D         // Direct 3D file upload (GLB, GLTF, OBJ, FBX)
  FLOOR_PLAN       // Floor plan image → AI-generated 3D
  INTERIOR_RENDER  // Interior render → depth-estimated 3D
  STRUCTURAL       // Structural drawing
  IMAGE            // Generic reference image
}

enum RevisionStatus {
  PROCESSING
  READY
  FAILED
}

model Revision {
  id            String         @id @default(cuid())
  roomId        String
  version       Int
  label         String         // e.g., "Concept", "Structural Layout", "Final"
  type          RevisionType
  status        RevisionStatus @default(PROCESSING)
  sourceFileUrl String         // Original uploaded file
  sceneUrl      String?        // Generated/optimized GLTF scene
  thumbnail     String?        // Preview image
  metadata      Json?          // Processing details, detected objects, etc.
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, version])
}

// ─── Activity Log ─────────────────────────────────────────────

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  ROOM_CREATED
  ROOM_UPDATED
  ROOM_DELETED
  OBJECT_ADDED
  OBJECT_UPDATED
  OBJECT_DELETED
  OBJECT_APPROVED
  OBJECT_REJECTED
  COMMENT_ADDED
  CLIENT_INVITED
  STATUS_CHANGED
  REVISION_CREATED
  REVISION_UPDATED
}

model Activity {
  id        String       @id @default(cuid())
  projectId String
  userId    String
  type      ActivityType
  message   String
  metadata  Json?
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
}

// ─── Approval System ──────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

model Approval {
  id        String         @id @default(cuid())
  objectId  String
  userId    String
  status    ApprovalStatus @default(PENDING)
  note      String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  object RoomObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([objectId])
}

// ─── Client Billing / Invoices ────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id          String        @id @default(cuid())
  designerId  String
  clientId    String
  projectId   String?
  number      String        // e.g., "INV-001"
  title       String
  description String?       @db.Text
  items       Json          // [{name, quantity, rate, amount}]
  subtotal    Float
  tax         Float         @default(0)
  total       Float
  currency    String        @default("INR")
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  designer Designer @relation(fields: [designerId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([designerId])
  @@index([clientId])
}

// ─── Notifications ────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ─── Project Drive ───────────────────────────────────────────

enum DriveItemType {
  FOLDER
  FILE
  LINK
}

model DriveItem {
  id           String       @id @default(cuid())
  projectId    String
  roomId       String?
  parentId     String?
  createdById  String?
  type         DriveItemType
  name         String
  phase        String?
  mimeType     String?
  extension    String?
  sizeBytes    Int?
  url          String?
  externalUrl  String?
  previewUrl   String?
  tags         String[]
  version      Int          @default(1)
  isLatest     Boolean      @default(true)
  is3D         Boolean      @default(false)
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  parent       DriveItem?   @relation("DriveItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     DriveItem[]  @relation("DriveItemTree")
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, parentId])
  @@index([projectId, roomId])
  @@index([projectId, phase])
}

// ─── View Finder ─────────────────────────────────────────────

model SavedView {
  id              String    @id @default(cuid())
  roomId          String
  revisionId      String?
  createdById     String?
  name            String
  cameraPosition  Json
  cameraRotation  Json
  target          Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([revisionId])
}

// ─── Tasks & Progress ────────────────────────────────────────

enum TaskScope {
  PROJECT
  ROOM
  PHASE
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model ProjectTask {
  id           String     @id @default(cuid())
  projectId    String
  roomId       String?
  assignedToId String?
  scope        TaskScope
  phase        String?
  title        String
  description  String?    @db.Text
  status       TaskStatus @default(NOT_STARTED)
  progress     Int        @default(0)
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room         Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assignedTo   User?      @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([projectId, scope])
  @@index([projectId, roomId])
  @@index([projectId, phase])
  @@index([assignedToId])
}

// ─── Quotation ───────────────────────────────────────────────

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum QuoteItemType {
  ROOM
  PHASE
  SERVICE
}

model Quotation {
  id          String         @id @default(cuid())
  projectId   String
  status      QuoteStatus    @default(DRAFT)
  currency    String         @default("INR")
  subtotal    Float          @default(0)
  total       Float          @default(0)
  notes       String?        @db.Text
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items       QuotationItem[]

  @@index([projectId, createdAt])
}

model QuotationItem {
  id           String        @id @default(cuid())
  quotationId  String
  itemType     QuoteItemType
  roomId       String?
  phase        String?
  title        String
  quantity     Float         @default(1)
  unitPrice    Float         @default(0)
  amount       Float         @default(0)
  createdAt    DateTime      @default(now())

  quotation    Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}
